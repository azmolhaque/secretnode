# Secrets & local config
.env
*.env
!.env.example

# Watch roster — names paying clients and their infrastructure. The template
# (watch-roster.example.json) is committed; the real one never is.
watch-roster.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Benchmark corpus — GENERATED by `make bench-http` / `python -m bench.benchmark
# --http`, which writes synthetic credentials into backend/bench-corpus/ and
# serves them over localhost. They are not real keys, but they are correctly
# SHAPED ones, so committing them trips GitHub push protection and blocks the
# push — which is what happened, and is why this entry exists. The corpus is
# deterministic from a fixed seed, so it costs nothing to regenerate and there
# is no reason to track it.
backend/bench-corpus/
# Unanchored as well: the corpus lands relative to the working directory
# the benchmark was invoked from, so running it from the repo root writes
# ./bench-corpus/ instead — which the path-anchored entry above does not
# cover, leaving the same push-protection trap one `cd` away.
bench-corpus/

# Runtime data / SQLite
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db-journal
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Reports / build artifacts
*.sarif
!.github/**/*.sarif
dist/
build/
backend/bench/.external-cache.json
